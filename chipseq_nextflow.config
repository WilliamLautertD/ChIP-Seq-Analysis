nextflow.enable.dsl = 2

params {
    samples = 'config/chipseq_samples.tsv'
    outdir  = 'results/chipseq_pipeline'

    reference_fasta = '/home/lauterw/refs/human_hg19_igenome/bowtie/hg19.fa'

    // =========================================================================
    //  MAPPER SELECTION
    // =========================================================================
    // Choose: 'bwa-mem2' or 'bowtie2'
    mapper = 'bowtie2'

    // bwa-mem2: binary + index basename.
    // NOTE: a bwa-mem2 index is NOT a plain-bwa index.
    // Expects: .0123 .amb .ann .bwt.2bit.64 .pac    Build once with:
    //   bwa-mem2 index /path/to/hg38.fa
    bwamem2_bin          = 'bwa-mem2'
    bwamem2_index_prefix = ''            // e.g. '/path/to/hg38.fa'
    bwamem2_extra        = ''

    // bowtie2: index basename (.1.bt2 .2.bt2 .3.bt2 .4.bt2 .rev.1.bt2 .rev.2.bt2)
    bowtie2_index_prefix = '/home/lauterw/refs/human_hg19_igenome/bowtie/hg19'            // e.g. '/path/to/hg38'
    bowtie2_extra        = ''            // e.g. '--very-sensitive --no-mixed --no-discordant'

    // =========================================================================
    //  BAM FILTERING
    // =========================================================================
    // Flags removed: 4 unmapped + 256 secondary + 1024 duplicate + 2048 supplementary
    exclude_flags = 3332

    // Single, uniform MAPQ applied once in the mapping/dedup process.
    // Currently 0 = no MAPQ filter. Set to 30 for the standard uniquely-mapped
    // filter. Downstream (bamCoverage) does NOT touch MAPQ.
    bam_min_mapq = 0

    // =========================================================================
    //  SIGNAL (stage 3) -- bigWigs + QC only; reads the finished BAMs as-is
    // =========================================================================
    blacklist_bed         = ''           // e.g. hg38-blacklist.v2.bed (bamCoverage --blackListFileName)
    effective_genome_size = 2913022398   // GRCh38, no alt/decoy

    // bamCoverage (per-file coverage track)
    bigwig_binsize       = 25
    bigwig_normalization = 'None'

    // bamCompare (ChIP vs matched input): ratio, no between-sample scale factor
    bamcompare_binsize       = 200
    bamcompare_smooth_length = 600

    // multiBigwigSummary (two runs)
    mbws_qc_binsize     = 10000          // #1: feeds PCA + correlation
    mbws_counts_binsize = 1000           // #2: npz + raw counts, for your later use
}

process {
    executor = 'local'
    conda    = 'envs/qc_mapping_cnv.yaml'

    // Fail a process if ANY command in a pipe fails.
    // Without this, a dying aligner still lets `samtools sort` exit 0 and write a
    // valid but EMPTY BAM -- a silent failure that only surfaces much later.
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: BWA_MEM2_ALIGN { cpus = 15 }
    withName: BOWTIE2_ALIGN  { cpus = 15 }

    withName: BAM_COVERAGE              { cpus = 20 }
    withName: BAM_COMPARE               { cpus = 20 }
    withName: BAM_COVERAGE_RPKM         { cpus = 20 }
    withName: MULTIBIGWIG_SUMMARY_QC    { cpus = 16 }
    withName: MULTIBIGWIG_SUMMARY_COUNTS{ cpus = 16 }
    withName: MULTIBIGWIG_SUMMARY_RPKM  { cpus = 16 }
    withName: PLOT_PCA                  { cpus = 15 }
    withName: PLOT_CORRELATION          { cpus = 15 }
    withName: PLOT_FINGERPRINT          { cpus = 12 }
}

profiles {
    conda {
        conda.enabled = true
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'h200'
        process.time     = '48h'
        process.memory   = '100 GB'
        conda.enabled    = true
    }
}

